{
    "compilerOptions": {
        "outDir": ".",
        "sourceMap": true,
        "strict": true,
        "strictFunctionTypes": false,
        "noUnusedLocals": true,
        "noImplicitReturns": true,
        "module": "esnext",
        "allowSyntheticDefaultImports": true,
        "target": "es5",
        "downlevelIteration": true,
        "lib": ["dom", "dom.iterable", "es2015"],
        "jsx": "react",
        "removeComments": true,
        "allowJs": true
    },
    "files": ["index.ts"]
}
